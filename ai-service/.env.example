# AI service environment example
USE_DUMMY_MODELS=false
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=sqlite+aiosqlite:///./ai_service.db

# Alerting settings
SLACK_WEBHOOK=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@intelsense.local
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_NEGATIVE_RATIO_THRESHOLD=30
ALERT_SCHEDULE_SECONDS=300

# SECURITY: Do NOT commit real credentials. Use environment variables or a
# secrets manager to supply SMTP_USERNAME and SMTP_PASSWORD.
# Application
APP_NAME=IntelSenseAI
ENVIRONMENT=development
API_PREFIX=/api/v1

# Database
DATABASE_URL=mysql+aiomysql://postgres:postgres@db:3306/intelsense_ai
DB_HOST=db
DB_PORT=3306
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=intelsense_ai

# Redis
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=change-me-local-intelsense-ai-jwt-signing-key-2026
JWT_ALGORITHM=HS256

# AI
MODEL_CACHE_DIR=/models
USE_DUMMY_MODELS=false

# App
LOG_LEVEL=INFO
