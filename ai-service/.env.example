# AI Service Configuration
# This file should be copied to .env and adjusted for your environment

# ===== APPLICATION =====
APP_NAME=IntelSense AI
ENVIRONMENT=development
API_PREFIX=/api/v1
APP_URL=http://localhost:3000

# ===== MODELS =====
# Disable background fake outputs; set to true only for explicit smoke tests
USE_DUMMY_MODELS=false

# ===== DATABASE =====
# IMPORTANT: For consistent local development, both the backend (Spring Boot)
# and this AI service should point to the SAME MySQL database.
#
# Option 1: Local MySQL (recommended for full local setup)
# DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/intelsense_ai
#
# Option 2: SQLite (simplest, but NOT shared with backend)
# DATABASE_URL=sqlite+aiosqlite:///./ai_service.db
#
# Option 3: PostgreSQL (if your setup uses Postgres)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/intelsense_ai
#
# Default for local dev: MySQL pointing to the same database as the backend
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/intelsense_ai

# Database connection settings (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=root
DB_NAME=intelsense_ai

# ===== REDIS =====
# Used for caching and session management
REDIS_URL=redis://localhost:6379/0

# ===== EMAIL / SMTP =====
# For password reset and OTP email delivery
# If using MailHog locally: SMTP_HOST=localhost, SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
ALERT_EMAIL_FROM=noreply@intelsense.local
ALERT_EMAIL_TO=

# ===== ALERTING =====
SLACK_WEBHOOK=
ALERT_NEGATIVE_RATIO_THRESHOLD=30
ALERT_SCHEDULE_SECONDS=300

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== SECURITY =====
JWT_SECRET=change-me-local-intelsense-ai-jwt-signing-key-2026
JWT_ALGORITHM=HS256

# SECURITY: Do NOT commit real credentials. Use environment variables or a
# secrets manager to supply sensitive values in production.
DB_NAME=intelsense_ai

# Redis
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET=change-me-local-intelsense-ai-jwt-signing-key-2026
JWT_ALGORITHM=HS256

# AI
MODEL_CACHE_DIR=/models
USE_DUMMY_MODELS=false

# App
LOG_LEVEL=INFO
